{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@shipbrace/app"
      ],
      "port": 5173
    },
    {
      "name": "review-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--experimental-strip-types",
        "--env-file=.env",
        "server/src/index.ts"
      ],
      "port": 3000
    }
  ]
}
