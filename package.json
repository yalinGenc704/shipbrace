{
  "name": "aegis",
  "private": true,
  "type": "module",
  "workspaces": ["app", "server", "packages/*"],
  "engines": { "bun": ">=1.4.0" },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "typecheck": "tsc --build --verbose",
    "lint": "oxlint --type-aware .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "oxlint": "1.80.0",
    "oxfmt": "0.65.0",
    "@types/bun": "latest"
  }
}
