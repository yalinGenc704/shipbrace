# Committed template. Copy to .env and fill in the real values there.
# .env is git-ignored; this file deliberately contains no working secrets.

# Anthropic API key, from console.anthropic.com. Starts with sk-ant-.
ANTHROPIC_API_KEY=<paste-your-key-here>

# Folder the review server may read. Defaults to this project.
# REVIEW_ROOT=.

# Look up known flaws in public packages on OSV.dev. "off" keeps reviews offline.
# PACKAGE_LOOKUP=on

# GitHub App (all three, or none). Created at github.com/settings/apps.
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY_PATH=./github-app.pem
# GITHUB_WEBHOOK_SECRET=<a long random string you also paste into the App>
