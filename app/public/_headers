# Security headers for the dashboard's files when Cloudflare serves them
# directly (cloud/wrangler.jsonc). Same policy as the Node server sets
# (server/src/index.ts): everything from this site only.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex
