// ShipBrace on Cloudflare.
// The Worker, database and queue keep the names they were created with before
// the project was renamed from "aegis": Cloudflare cannot rename a database or
// a queue, and a renamed Worker is a new Worker whose secrets must all be set
// again. Nobody outside sees these names; the public address is the domain.
// Secrets are never written here: `npx wrangler secret put GITHUB_PRIVATE_KEY`
// and the same for GITHUB_WEBHOOK_SECRET and ANTHROPIC_API_KEY.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aegis",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The one public address. Cloudflare adds the DNS entry and certificate.
  "routes": [{ "pattern": "app.shipbrace.com", "custom_domain": true }],
  // No second address on workers.dev: one front door.
  "workers_dev": false,

  // The dashboard's built files. Page addresses fall back to index.html; only
  // /api/* runs the Worker. Security headers for these files: app/public/_headers.
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  "vars": {
    "PUBLIC_URL": "https://app.shipbrace.com",
    "GITHUB_APP_ID": "5157570",
    "GITHUB_APP_SLUG": "shipbrace",
    "GITHUB_CLIENT_ID": "Iv23liy8pr9ByG3NznCo",
    "AI_REVIEW": "on",
    "PACKAGE_LOOKUP": "on",
    // Reviews started per rolling 24 hours, across everyone and per GitHub
    // installation. Low while ShipBrace is private; raise at launch.
    "DAILY_REVIEW_LIMIT": "50",
    "MONTHLY_REVIEW_LIMIT": "50",
    "ACCOUNT_DAILY_REVIEW_LIMIT": "10",
    "AI_ALLOWED_GITHUB_IDS": "174497899",
    // Invite-only until launch: only these GitHub accounts can sign in.
    "ALLOWED_GITHUB_USERS": "yalinGenc704"
  },

  // Review history. Create once with `npx wrangler d1 create aegis-history`
  // and put the id it prints here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aegis-history",
      "database_id": "6fae9e24-2641-4274-ad45-0de2b0e00f2b",
      "migrations_dir": "migrations"
    }
  ],

  // Pushes wait here, so GitHub is answered at once. One at a time, never
  // retried (a retry would post a second check for the same commit).
  "queues": {
    "producers": [{ "binding": "REVIEWS", "queue": "aegis-reviews" }],
    "consumers": [{ "queue": "aegis-reviews", "max_batch_size": 1, "max_retries": 0 }]
  },

  // The reviewer: one container per review, no internet (src/reviewer.ts).
  // standard-1 = half a CPU and 4 GB, room for a review's 1 GB limit.
  "containers": [
    {
      "class_name": "Reviewer",
      "image": "./reviewer.Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REVIEWER", "class_name": "Reviewer" },
      // Exact per-minute limits: 60 requests per signed-in person, 10 sign-in
      // attempts or pasted links (src/rate-counter.ts, src/accounts.ts).
      { "name": "RATE_COUNTER", "class_name": "RateCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Reviewer"] },
    { "tag": "v2", "new_sqlite_classes": ["RateCounter"] }
  ],

  // Nightly clean-up (src/index.ts, `scheduled`): reviews older than 90 days.
  "triggers": { "crons": ["17 3 * * *"] }
}
